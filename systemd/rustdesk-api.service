[Unit]
Description=RustDesk API Server (lejianwen/rustdesk-api v2.7)
After=network.target rustdesk-hbbs.service

[Service]
WorkingDirectory=/opt/rustdesk-api/release
ExecStart=/opt/rustdesk-api/release/apimain -c /opt/rustdesk-api/release/conf/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
